/**
 * Snippet24 — Article Updater
 *
 * Unlimited article updates.
 * Does NOT depend on the current article count.
 */

const fs = require("fs");
const crypto = require("crypto");

const FILE = "./articles.json";

// --------------------------------------------------
// Load existing articles
// --------------------------------------------------

function loadArticles() {
  if (!fs.existsSync(FILE)) {
    return {
      site: "Snippet24",
      site_url: "https://snippet24.in",
      articles: []
    };
  }

  const data = JSON.parse(fs.readFileSync(FILE, "utf8"));

  if (!Array.isArray(data.articles)) {
    data.articles = [];
  }

  return data;
}

// --------------------------------------------------
// Generate unique ID
// --------------------------------------------------

function generateId() {
  return crypto.randomBytes(10).toString("hex");
}

// --------------------------------------------------
// Clean article
// --------------------------------------------------

function normalizeArticle(article) {
  const now = new Date().toISOString();

  const headline =
    article.headline ||
    article.title ||
    "Untitled Story";

  const points = Array.isArray(article.snippet_lines)
    ? article.snippet_lines
    : [];

  return {
    id: article.id || generateId(),

    category:
      article.category || "In India",

    headline,

    // Keep old field for compatibility
    snippet:
      article.snippet ||
      points.join("\n"),

    // Exactly three editorial content points
    snippet_lines: [
      points[0] || headline,
      points[1] || "",
      points[2] || ""
    ],

    summary:
      article.summary ||
      headline,

    publisher:
      article.publisher ||
      "",

    source_type:
      article.source_type ||
      "OFFICIAL",

    source_label:
      article.source_label ||
      "Official Source",

    importance:
      article.importance ||
      "MEDIUM",

    published_at:
      article.published_at ||
      now,

    source_url:
      article.source_url ||
      article.original_source_url ||
      "",

    original_source_url:
      article.original_source_url ||
      article.source_url ||
      "",

    image_url:
      article.image_url ||
      "",

    image_usage:
      article.image_usage ||
      "NONE",

    ai_rewritten:
      article.ai_rewritten ?? true,

    ai_disclosure:
      true,

    ai_disclosure_text:
      "Snippet24 uses an AI-assisted editorial process to condense and rephrase source material. The original source remains the authority for the complete report.",

    // New editorial note
    editorial_note:
      "Rephrased from the original source for clarity.",

    attribution_required:
      true,

    copyright_status:
      article.copyright_status ||
      "THIRD_PARTY_SOURCE",

    correction_available:
      true,

    grievance_available:
      true,

    translations:
      article.translations || {}
  };
}

// --------------------------------------------------
// Add a new article
// --------------------------------------------------

function addArticle(article) {
  const data = loadArticles();

  const newArticle = normalizeArticle(article);

  // Prevent duplicate source/article IDs
  const duplicate = data.articles.find(
    item =>
      item.id === newArticle.id ||
      (
        newArticle.original_source_url &&
        item.original_source_url === newArticle.original_source_url
      )
  );

  if (duplicate) {
    console.log("Article already exists:", duplicate.id);
    return duplicate;
  }

  data.articles.unshift(newArticle);

  updateMetadata(data);

  saveArticles(data);

  console.log("Article added:", newArticle.headline);

  return newArticle;
}

// --------------------------------------------------
// Update an existing article
// --------------------------------------------------

function updateArticle(id, changes) {
  const data = loadArticles();

  const index = data.articles.findIndex(
    article => article.id === id
  );

  if (index === -1) {
    console.log("Article not found:", id);
    return null;
  }

  const updated = normalizeArticle({
    ...data.articles[index],
    ...changes,
    id
  });

  data.articles[index] = updated;

  updateMetadata(data);

  saveArticles(data);

  console.log("Article updated:", updated.headline);

  return updated;
}

// --------------------------------------------------
// Remove an article
// --------------------------------------------------

function removeArticle(id) {
  const data = loadArticles();

  const before = data.articles.length;

  data.articles = data.articles.filter(
    article => article.id !== id
  );

  if (data.articles.length === before) {
    console.log("Article not found:", id);
    return false;
  }

  updateMetadata(data);

  saveArticles(data);

  console.log("Article removed:", id);

  return true;
}

// --------------------------------------------------
// Metadata
// --------------------------------------------------

function updateMetadata(data) {
  data.updated_at = new Date().toISOString();

  // IMPORTANT:
  // This is calculated dynamically.
  // There is NO 370-story limit.
  data.total = data.articles.length;

  // Recalculate categories
  const categories = {};

  for (const article of data.articles) {
    const category = article.category || "In India";

    categories[category] =
      (categories[category] || 0) + 1;
  }

  data.categories = categories;

  // Recalculate source types
  const sourceTypes = {};

  for (const article of data.articles) {
    const sourceType =
      article.source_type || "UNKNOWN";

    sourceTypes[sourceType] =
      (sourceTypes[sourceType] || 0) + 1;
  }

  data.source_types = sourceTypes;
}

// --------------------------------------------------
// Save
// --------------------------------------------------

function saveArticles(data) {
  fs.writeFileSync(
    FILE,
    JSON.stringify(data, null, 2),
    "utf8"
  );
}

// --------------------------------------------------
// Example usage
// --------------------------------------------------

const article = {
  category: "In India",

  headline:
    "New development reported in India",

  snippet_lines: [
    "A new development has been reported.",
    "The development could affect people and businesses.",
    "Further details are available from the official source."
  ],

  summary:
    "A new development has been reported in India.",

  publisher:
    "Official Source",

  source_type:
    "PUBLIC_BROADCASTER",

  source_label:
    "Public Broadcaster",

  importance:
    "MEDIUM",

  published_at:
    new Date().toISOString(),

  source_url:
    "https://example.com",

  original_source_url:
    "https://example.com"
};

// Add article
addArticle(article);