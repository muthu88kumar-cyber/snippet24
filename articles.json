const fs = require("fs");
const crypto = require("crypto");

const ARTICLES_FILE = "./articles.json";

const AI_DISCLOSURE =
  "Snippet24 uses an AI-assisted editorial process to condense and rephrase source material. The original source remains the authority for the complete report.";

const EDITORIAL_NOTE =
  "Rephrased from the original source for clarity.";

const DEFAULT_POLICY = {
  source_policy:
    "Only government, public broadcaster, official TV and verified official YouTube sources are accepted. Private/unknown sources are rejected.",

  global_policy:
    "Global contains clearly international events. India-related foreign affairs remain under In India.",

  ai_policy:
    "AI-assisted rewriting produces a headline, reading levels, a short summary and controlled translations."
};

function generateId() {
  return crypto.randomBytes(10).toString("hex");
}

function loadDatabase() {
  if (!fs.existsSync(ARTICLES_FILE)) {
    return {
      site: "Snippet24",
      site_url: "https://snippet24.in",
      updated_at: new Date().toISOString(),
      total: 0,
      editorial_engine: "Snippet24 AI Editorial",
      ...DEFAULT_POLICY,
      articles: []
    };
  }

  const data = JSON.parse(
    fs.readFileSync(ARTICLES_FILE, "utf8")
  );

  if (!Array.isArray(data.articles)) {
    data.articles = [];
  }

  return data;
}

function normalizeReading(article) {
  const lines = Array.isArray(article.snippet_lines)
    ? article.snippet_lines.filter(Boolean)
    : [];

  const headline =
    article.headline ||
    article.title ||
    lines[0] ||
    "Untitled Story";

  const existingReading = article.reading || {};

  return {
    "10_sec":
      existingReading["10_sec"] ||
      lines[0] ||
      headline,

    "60_sec": {
      what_happened:
        existingReading["60_sec"]?.what_happened ||
        lines[0] ||
        headline,

      why_it_matters:
        existingReading["60_sec"]?.why_it_matters ||
        article.summary ||
        lines[1] ||
        ""
    },

    "3_min": {
      what_happened:
        existingReading["3_min"]?.what_happened ||
        lines[0] ||
        headline,

      why_it_matters:
        existingReading["3_min"]?.why_it_matters ||
        article.summary ||
        lines[1] ||
        "",

      who_is_affected:
        existingReading["3_min"]?.who_is_affected ||
        "",

      whats_next:
        existingReading["3_min"]?.whats_next ||
        ""
    }
  };
}

function normalizeArticle(article) {
  const headline =
    article.headline ||
    article.title ||
    "Untitled Story";

  const lines = Array.isArray(article.snippet_lines)
    ? article.snippet_lines
    : [];

  const normalizedLines = [
    lines[0] || headline,
    lines[1] || "",
    lines[2] || ""
  ];

  return {
    id: article.id || generateId(),

    category:
      article.category || "In India",

    headline,

    reading: normalizeReading(article),

    snippet:
      normalizedLines
        .filter(Boolean)
        .join("\n"),

    snippet_lines: normalizedLines,

    summary:
      article.summary ||
      headline,

    publisher:
      article.publisher ||
      "",

    source_type:
      article.source_type ||
      "OFFICIAL",

    source_label:
      article.source_label ||
      "Official Source",

    importance:
      article.importance ||
      "MEDIUM",

    published_at:
      article.published_at ||
      new Date().toISOString(),

    source_url:
      article.source_url ||
      article.original_source_url ||
      "",

    original_source_url:
      article.original_source_url ||
      article.source_url ||
      "",

    image_url:
      article.image_url ||
      "",

    image_usage:
      article.image_usage ||
      "NONE",

    ai_rewritten:
      article.ai_rewritten ?? true,

    ai_disclosure: true,

    ai_disclosure_text:
      AI_DISCLOSURE,

    editorial_note:
      EDITORIAL_NOTE,

    attribution_required: true,

    copyright_status:
      article.copyright_status ||
      "THIRD_PARTY_SOURCE",

    copyright_notice:
      article.copyright_notice ||
      "Third-party material remains the property of its respective owner.",

    editorial_notice:
      article.editorial_notice ||
      "Claims and allegations are attributed to the identified source or authority.",

    legal_notice:
      article.legal_notice ||
      "Snippet24 provides general news and informational content.",

    correction_available: true,

    grievance_available: true,

    translations:
      article.translations || {}
  };
}

function rebuildMetadata(data) {
  data.updated_at =
    new Date().toISOString();

  // NO LIMIT
  data.total =
    data.articles.length;

  data.categories = {};

  data.source_types = {};

  for (const article of data.articles) {
    const category =
      article.category || "In India";

    const sourceType =
      article.source_type || "UNKNOWN";

    data.categories[category] =
      (data.categories[category] || 0) + 1;

    data.source_types[sourceType] =
      (data.source_types[sourceType] || 0) + 1;
  }

  data.editorial_engine =
    "Snippet24 AI Editorial";

  data.ai_disclosure =
    AI_DISCLOSURE;
}

function saveDatabase(data) {
  rebuildMetadata(data);

  fs.writeFileSync(
    ARTICLES_FILE,
    JSON.stringify(data, null, 2),
    "utf8"
  );
}

function addArticle(article) {
  const data = loadDatabase();

  const normalized =
    normalizeArticle(article);

  const duplicate =
    data.articles.find(item =>
      item.id === normalized.id ||
      (
        normalized.original_source_url &&
        item.original_source_url ===
          normalized.original_source_url
      )
    );

  if (duplicate) {
    console.log(
      "Duplicate article:",
      duplicate.id
    );

    return duplicate;
  }

  data.articles.unshift(normalized);

  saveDatabase(data);

  console.log(
    `Article added. Total: ${data.total}`
  );

  return normalized;
}

function updateArticle(id, changes) {
  const data = loadDatabase();

  const index =
    data.articles.findIndex(
      article => article.id === id
    );

  if (index === -1) {
    console.log(
      "Article not found:",
      id
    );

    return null;
  }

  data.articles[index] =
    normalizeArticle({
      ...data.articles[index],
      ...changes,
      id
    });

  saveDatabase(data);

  console.log(
    "Article updated:",
    id
  );

  return data.articles[index];
}

function deleteArticle(id) {
  const data = loadDatabase();

  const before =
    data.articles.length;

  data.articles =
    data.articles.filter(
      article => article.id !== id
    );

  if (before === data.articles.length) {
    console.log(
      "Article not found:",
      id
    );

    return false;
  }

  saveDatabase(data);

  console.log(
    `Article deleted. Total: ${data.total}`
  );

  return true;
}

