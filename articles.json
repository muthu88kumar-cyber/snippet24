if (require.main === module) {

  addArticle({
    category: "In India",

    headline:
      "New development reported in India",

    snippet_lines: [
      "A new development has been reported.",
      "The development could affect people and businesses.",
      "Further official information is expected."
    ],

    summary:
      "A new development has been reported in India.",

    publisher:
      "Official Source",

    source_type:
      "PUBLIC_BROADCASTER",

    source_label:
      "Public Broadcaster",

    importance:
      "MEDIUM",

    published_at:
      new Date().toISOString(),

    source_url:
      "https://example.com",

    original_source_url:
      "https://example.com",

    reading: {
      "10_sec":
        "A new development has been reported.",

      "60_sec": {
        what_happened:
          "A new development has been reported.",

        why_it_matters:
          "It may affect people and businesses."
      },

      "3_min": {
        what_happened:
          "A new development has been reported.",

        why_it_matters:
          "The development may have wider implications.",

        who_is_affected:
          "People and businesses connected to the development.",

        whats_next:
          "Watch for further official announcements."
      }
    }
  });
}

module.exports = {
  loadDatabase,
  addArticle,
  updateArticle,
  deleteArticle,
  normalizeArticle
};